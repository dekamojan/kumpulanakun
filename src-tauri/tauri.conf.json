{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VGenMulti",
  "version": "1.2.0",
  "identifier": "com.vgenmulti.desktop",
  "build": { 
    "beforeDevCommand": "npm run dev", 
    "devUrl": "http://localhost:5173", 
    "beforeBuildCommand": "npm run build", 
    "frontendDist": "../dist" 
  },
  "app": { 
    "windows": [
      { 
        "title": "VGenMulti", 
        "width": 540, 
        "height": 620, 
        "minWidth": 540, 
        "minHeight": 620, 
        "resizable": true, 
        "center": true, 
        "decorations": true, 
        "theme": "Dark" 
      }
    ], 
    "security": { "csp": null } 
  },
  "bundle": { 
    "active": true, 
    "targets": "nsis", 
    "createUpdaterArtifacts": false, 
    "icon": ["icons/icon.ico"], 
    "windows": { 
      "nsis": { 
        "installerIcon": "icons/icon.ico", 
        "uninstallerIcon": "icons/icon.ico", 
        "installerHooks": "installer-hooks.nsh" 
      } 
    } 
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRkUyQ0M1QzU2N0M2QkEKUldTVHlkRzBSblhHdll6WGRIT3NheHNKbC9qOU11WTRqVlI0K2dEMjN3aFp5ZUpVWGpsb1lNSGsK"
    }
  }
}
