{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowpilot",
  "version": "1.2.0",
  "identifier": "com.flowpilot.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Flowpilot", "width": 540, "height": 620, "minWidth": 540, "minHeight": 620, "resizable": false, "center": true, "decorations": true, "theme": "Dark" }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "nsis", "createUpdaterArtifacts": true, "icon": ["icons/icon.ico"], "windows": { "nsis": { "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico", "installerHooks": "installer-hooks.nsh" } } },
"plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
